# Local mode is the default and does not require an online account.
FUORI_STUDIO_MODE=local

# Optional remote owner authentication (hybrid / online).
# Register this exact redirect with an OIDC provider:
# https://studio.example.com/auth/callback
# Use the immutable subject for this client, not an email address or username.
# See docs/IDENTITY.md. Do not commit a filled .env file.
# FUORI_STUDIO_MODE=hybrid
# FUORI_STUDIO_PUBLIC_URL=https://studio.example.com
# FUORI_STUDIO_OIDC_ISSUER=https://identity.example.com
# FUORI_STUDIO_OIDC_CLIENT_ID=
# FUORI_STUDIO_OIDC_CLIENT_SECRET=
# FUORI_STUDIO_OWNER_SUBJECT=
# FUORI_STUDIO_OIDC_CLIENT_AUTH=client_secret_basic

# Remote deployments must provide a separate 32-byte base64 master key.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Store it in your deployment secret manager, not in Git.
# FUORI_STUDIO_MASTER_KEY=
# The default remote bind is loopback behind an HTTPS reverse proxy.
# FUORI_STUDIO_BIND=127.0.0.1
# PORT=4386
# FUORI_STUDIO_DATA_DIR=/absolute/private/data
# FUORI_STUDIO_CODEX_BIN=/absolute/path/to/codex
# FUORI_STUDIO_DEVICE_DIR=/absolute/private/worker-data

# Optional additional read-only folder roots for source imports.
# The app source and explicitly registered repository paths are allowed locally.
# Separate multiple absolute paths with ':' on macOS/Linux or ';' on Windows.
# FUORI_STUDIO_SOURCE_ROOTS=/absolute/path/to/notes:/absolute/path/to/specifications
